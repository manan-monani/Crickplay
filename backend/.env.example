# Backend Environment Variables
# Copy to .env and configure

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crickplay

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Auth
SECRET_KEY=change-me-in-production-min-32-characters
JWT_SECRET=change-me-in-production-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Claude AI
ANTHROPIC_API_KEY=sk-ant-api-xxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
