# Backend API Environment Configuration
# Copy this file to .env and update values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://crickplay_user:crickplay_password@localhost:5432/crickplay_db
DATABASE_SYNC_URL=postgresql://crickplay_user:crickplay_password@localhost:5432/crickplay_db

# Redis Configuration
REDIS_URL=redis://:crickplay_redis_password@localhost:6379/0

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=Crickplay API
VERSION=0.1.0
DEBUG=True

# CORS Configuration (Next.js frontend)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_ENABLED=True

# Kafka Configuration (for existing Phase 1 integration)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=live_match_deliveries

# Environment
ENVIRONMENT=development
