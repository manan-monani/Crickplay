{
  "name": "post-run",
  "description": "Actions to perform after completing agent tasks",
  "hooks": [
    {
      "name": "check-uncommitted",
      "description": "Check for uncommitted changes",
      "command": "git status --porcelain",
      "onOutput": {
        "ifNotEmpty": "warn",
        "message": "Warning: Uncommitted changes detected"
      },
      "onFailure": "warn"
    },
    {
      "name": "run-format",
      "description": "Format changed files",
      "command": "npm run format --if-present",
      "onFailure": "warn"
    },
    {
      "name": "run-lint",
      "description": "Lint changed files",
      "command": "npm run lint --if-present",
      "onFailure": "warn"
    },
    {
      "name": "update-task-status",
      "description": "Reminder to update task status",
      "type": "reminder",
      "message": "Remember to update .ai/memory/tasks.md with current progress",
      "onFailure": "continue"
    }
  ],
  "triggers": {
    "onSessionEnd": true,
    "onTaskComplete": true,
    "onBranchSwitch": false
  }
}
