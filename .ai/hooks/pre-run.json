{
  "name": "pre-run",
  "description": "Actions to perform before starting agent tasks",
  "hooks": [
    {
      "name": "sync-repository",
      "description": "Sync with remote repository",
      "command": "git fetch origin",
      "onFailure": "warn"
    },
    {
      "name": "check-branch",
      "description": "Display current branch status",
      "command": "git status --short --branch",
      "onFailure": "warn"
    },
    {
      "name": "load-environment",
      "description": "Load environment variables",
      "command": "test -f .env && echo 'Environment loaded' || echo 'No .env file'",
      "onFailure": "continue"
    }
  ],
  "triggers": {
    "onSessionStart": true,
    "onTaskStart": false
  }
}
