# Crickplay Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!

# ============================================
# Application
# ============================================
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# ============================================
# Database - PostgreSQL
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crickplay
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crickplay
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# For MCP Postgres server
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/crickplay

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# Kafka
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DELIVERIES=cricket.deliveries
KAFKA_TOPIC_MATCH_EVENTS=cricket.match_events
KAFKA_CONSUMER_GROUP=crickplay-consumer

# ============================================
# Authentication (JWT)
# ============================================
JWT_SECRET=your-jwt-secret-key-min-32-chars-for-security
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ============================================
# Google Gemini AI
# ============================================
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# MLflow (ML Tracking)
# ============================================
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=crickplay-win-probability

# ============================================
# MCP Server Configuration
# ============================================
# GitHub Personal Access Token
GITHUB_TOKEN=

# Sentry (error tracking)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_DSN=

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_FAN_PER_HOUR=100
RATE_LIMIT_PROFESSIONAL_PER_HOUR=1000

# ============================================
# Feature Flags
# ============================================
FEATURE_GENAI_ENABLED=true
FEATURE_REALTIME_WP_ENABLED=true

# ============================================
# Testing
# ============================================
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crickplay_test
