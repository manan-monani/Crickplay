# Crickplay Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!

# ============================================
# Application
# ============================================
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# ============================================
# Database - PostgreSQL
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crickplay
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crickplay
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# For MCP Postgres server
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/crickplay

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# Kafka
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DELIVERIES=cricket.deliveries
KAFKA_TOPIC_MATCH_EVENTS=cricket.match_events
KAFKA_CONSUMER_GROUP=crickplay-consumer

# ============================================
# Authentication (JWT)
# ============================================
JWT_SECRET=your-jwt-secret-key-min-32-chars-for-security
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ============================================
# Anthropic (Claude AI)
# ============================================
ANTHROPIC_API_KEY=sk-ant-api-xxx

# ============================================
# Stripe (Payments)
# ============================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ============================================
# MLflow (ML Tracking)
# ============================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=crickplay-win-probability

# ============================================
# MCP Server Configuration
# ============================================
# Brave Search API (for web search)
BRAVE_API_KEY=

# GitHub Personal Access Token
GITHUB_TOKEN=

# Slack
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_TEAM_ID=

# Notion
NOTION_API_KEY=

# Supabase (optional - if using instead of local Postgres)
SUPABASE_URL=
SUPABASE_KEY=

# Sentry (error tracking)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_DSN=

# Cloudflare (optional - for edge deployment)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_FAN_PER_HOUR=100
RATE_LIMIT_PROFESSIONAL_PER_HOUR=1000
# Enterprise tier is unlimited

# ============================================
# Feature Flags
# ============================================
FEATURE_GENAI_ENABLED=true
FEATURE_REALTIME_WP_ENABLED=true

# ============================================
# Testing
# ============================================
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crickplay_test
