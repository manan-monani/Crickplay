# Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ============================================
# Database
# ============================================
# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/crickplay_dev
DATABASE_POOL_SIZE=10

# MySQL (if using MySQL)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=crickplay_dev

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# External Services
# ============================================
# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ============================================
# MCP Server Configuration
# ============================================
# Brave Search API
BRAVE_API_KEY=

# GitHub
GITHUB_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# Notion
NOTION_API_KEY=

# Supabase (if using)
SUPABASE_URL=
SUPABASE_KEY=

# Sentry (error tracking)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_DSN=

# ============================================
# Feature Flags
# ============================================
FEATURE_FLAG_NEW_FEATURE=false

# ============================================
# Monitoring
# ============================================
# New Relic
# NEW_RELIC_LICENSE_KEY=
# NEW_RELIC_APP_NAME=Crickplay Dev

# ============================================
# Testing
# ============================================
TEST_DATABASE_URL=postgres://user:password@localhost:5432/crickplay_test
